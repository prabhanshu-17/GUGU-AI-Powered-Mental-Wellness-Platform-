{
  "name": "gugu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute gugu-db --local --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute gugu-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute gugu-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.4.0",
    "jose": "^5.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.60.0"
  }
}
